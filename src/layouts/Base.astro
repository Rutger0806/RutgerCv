---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/halftone.css';
import '../styles/global.css';
import { profile } from '../data/profile';

const title = `${profile.name} - CV and portfolio`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="CV and portfolio of Rutger Witjas, told as a journey up and across a mountain range." />
    <meta name="theme-color" content="#1767c9" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <link rel="preload" href="/fonts/BodoniModa-normal-400.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fonts/DMMono-normal-400.ttf" as="font" type="font/ttf" crossorigin />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip" href="#education">Skip to the CV Sections</a>
    <div class="grid-lines" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
    <main>
      <slot />
    </main>
    <script>
      import '../motion/index.ts';
    </script>
  </body>
</html>
